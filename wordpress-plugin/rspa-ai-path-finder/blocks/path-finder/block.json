{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rspa/ai-path-finder",
	"version": "1.2.0",
	"title": "AI Path Finder",
	"category": "widgets",
	"icon": "welcome-learn-more",
	"description": "The RSPA AI Path Finder quiz — six questions, one personalized AI curriculum printed as a receipt. Embed the quiz, or show a card or button that opens it in a popup.",
	"keywords": [
		"rspa",
		"quiz",
		"ai",
		"path finder",
		"pathfinder",
		"curriculum",
		"receipt"
	],
	"textdomain": "rspa-ai-path-finder",
	"attributes": {
		"display": {
			"type": "string",
			"enum": [
				"embed",
				"card",
				"button"
			],
			"default": "embed"
		},
		"open": {
			"type": "string",
			"enum": [
				"popup",
				"page"
			],
			"default": "popup"
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"blurb": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": ""
		},
		"newTab": {
			"type": "boolean",
			"default": false
		},
		"initialHeight": {
			"type": "number",
			"default": 640
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full",
			"left",
			"center",
			"right"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"example": {
		"attributes": {
			"display": "embed"
		}
	},
	"editorScript": "rspa-ai-path-finder-editor",
	"viewScript": "rspa-ai-path-finder-embed",
	"style": "rspa-ai-path-finder"
}
